# MongoDB Atlas (free M0 tier)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/telesto?retryWrites=true&w=majority

# Cloudinary (media storage)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Global Fishing Watch API
GFW_API_KEY=

# Frontend origin allowed to hit this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# YOLO weights path (relative to backend/)
YOLO_WEIGHTS_PATH=weights/telesto_marine_yolov8n.pt
